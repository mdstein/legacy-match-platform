{
  "name": "aftertick",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "A community-run competitive CS:GO matchmaking platform prototype.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors yellow,blue \"npm run dev --workspace @aftertick/api\" \"npm run dev --workspace @aftertick/web\"",
    "dev:api": "npm run dev --workspace @aftertick/api",
    "dev:web": "npm run dev --workspace @aftertick/web",
    "build": "npm run build --workspaces --if-present && npm run launcher:build",
    "preview": "concurrently --kill-others --names api,web --prefix-colors yellow,blue \"npm run start:preview --workspace @aftertick/api\" \"npm run preview --workspace @aftertick/web\"",
    "preview:e2e": "concurrently --kill-others --names api-e2e,web-e2e --prefix-colors yellow,blue \"npm run start:e2e --workspace @aftertick/api\" \"npm run preview:e2e --workspace @aftertick/web\"",
    "infra:up": "node scripts/docker-compose.mjs up -d --wait",
    "infra:down": "node scripts/docker-compose.mjs down",
    "infra:status": "node scripts/docker-compose.mjs ps",
    "infra:observability:up": "node scripts/docker-compose.mjs -f compose.yml -f compose.observability.yml up -d --wait",
    "infra:observability:down": "node scripts/docker-compose.mjs -f compose.yml -f compose.observability.yml down",
    "infra:observability:status": "node scripts/docker-compose.mjs -f compose.yml -f compose.observability.yml ps",
    "infra:iac:validate": "node scripts/validate-opentofu.mjs",
    "deploy:config": "node scripts/docker-compose.mjs -f compose.deploy.yml config --quiet",
    "deploy:host:config": "node scripts/validate-hosted-compose.mjs",
    "test:cloudflared:image": "node scripts/test-cloudflared-image.mjs",
    "deploy:build": "node scripts/docker-compose.mjs -f compose.deploy.yml build",
    "deploy:migrate": "node scripts/docker-compose.mjs -f compose.deploy.yml --profile ops run --rm migrate",
    "deploy:seed": "node scripts/docker-compose.mjs -f compose.deploy.yml --profile ops run --rm seed",
    "retention:dry-run": "npm run retention:dry-run --workspace @aftertick/api",
    "retention:apply": "npm run retention:apply --workspace @aftertick/api",
    "deploy:retention:dry-run": "node scripts/docker-compose.mjs -f compose.deploy.yml --profile ops run --rm retention",
    "deploy:retention:apply": "node scripts/docker-compose.mjs -f compose.deploy.yml --profile ops run --rm retention node apps/api/dist/retention.js --apply",
    "deploy:host:release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\create-app-host-release.ps1",
    "deploy:host:release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\verify-app-host-release.ps1",
    "test:deployment:rollback": "npm run deploy:build && node scripts/run-deployment-rollback-smoke.mjs",
    "test:linux-host-release": "node scripts/run-linux-host-release-test.mjs",
    "test:hosted:preflight": "node scripts/test-hosted-preflight.mjs",
    "hosted:preflight": "node scripts/verify-hosted-platform.mjs --require-game",
    "game:plugin:build": "node scripts/build-sourcemod-plugin.mjs",
    "game:anticheat:build": "node scripts/build-smac-plugins.mjs",
    "game:toolchain:install": "powershell -ExecutionPolicy Bypass -File .\\scripts\\install-game-toolchain.ps1",
    "game:server:provision": "npm run game:plugin:build && npm run game:anticheat:build && node scripts/provision-game-server.mjs",
    "game:server:smoke": "node scripts/smoke-game-server.mjs",
    "game:node:run": "npm run start --workspace @aftertick/node-agent",
    "game:node:register": "tsx scripts/register-game-node.ts",
    "game:node:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-local-node-agent.ps1",
    "game:node:release": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\create-game-node-release.ps1",
    "game:node:release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\verify-game-node-release.ps1",
    "test:game-node:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\test-game-node-installer.ps1",
    "steam:smoke:serve": "node scripts/serve-steam-openid-smoke.mjs",
    "demo:analyzer:build": "node scripts/build-demo-analyzer.mjs",
    "demo:analyzer:test": "node scripts/build-demo-analyzer.mjs",
    "demo:analyze:match": "npm run demo:analyzer:build && tsx scripts/run-demo-analysis-worker.ts",
    "launcher:build": "npm run build --workspace @aftertick/launcher-ui && cargo build --release --locked --manifest-path apps/launcher/Cargo.toml",
    "launcher:release": "npm run launcher:build && node scripts/stage-launcher-release.mjs",
    "launcher:test": "npm run build --workspace @aftertick/launcher-ui && cargo test --locked --manifest-path apps/launcher/Cargo.toml",
    "launcher:doctor": "apps\\launcher\\target\\release\\b2g-launcher.exe doctor --json",
    "uat:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\prepare-local-game-playtest.ps1",
    "db:migrate": "npm run migrate --workspace @aftertick/db",
    "db:seed": "npm run seed --workspace @aftertick/db",
    "backup:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backup-local.ps1",
    "backup:prune:local": "node scripts/prune-local-backups.mjs",
    "backup:prune:local:apply": "node scripts/prune-local-backups.mjs --apply",
    "test:retention:backups": "node scripts/test-backup-retention.mjs",
    "restore:drill:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\restore-drill-local.ps1",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --dir . --exclude **/.artifacts/** --exclude **/vendor/** --exclude **/.agents/** && npm run launcher:test",
    "test:watch": "vitest --dir .",
    "test:integration:db": "node scripts/run-db-integration.mjs",
    "test:integration:latency": "node scripts/run-latency-probe-launcher-integration.mjs",
    "test:integration:redis": "node scripts/run-redis-integration.mjs",
    "test:integration:api": "node scripts/run-api-integration.mjs",
    "test:integration:node-agent": "npm run build && node scripts/run-node-agent-integration.mjs",
    "test:integration:platform": "npm run game:plugin:build && npm run demo:analyzer:build && npm run build && tsx scripts/run-full-platform-integration.ts",
    "test:resilience": "npm run build && node scripts/run-resilience-drill.mjs",
    "test:observability": "npm run build && node scripts/run-observability-smoke.mjs",
    "matchmaker:inspect": "tsx scripts/inspect-matchmaker.ts",
    "trading:control": "tsx apps/api/src/trading-control.ts",
    "test:load:queue": "tsx scripts/run-queue-load-smoke.ts",
    "test:load:smoke": "npm run build && node scripts/run-load-smoke.mjs",
    "test:e2e": "npm run build && npm run build:e2e --workspace @aftertick/web && node scripts/run-e2e.mjs",
    "test:e2e:headed": "npm run build && npm run build:e2e --workspace @aftertick/web && node scripts/run-e2e.mjs --headed",
    "tooling:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\check-autonomous-tooling.ps1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
