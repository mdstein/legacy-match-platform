# Docker Compose interpolation only. Keep application and migration secrets in
# their separate mode-0640 environment files.
AFTERTICK_API_IMAGE=ghcr.io/example/aftertick-api@sha256:replace-with-64-hex-digest
AFTERTICK_WEB_IMAGE=ghcr.io/example/aftertick-web@sha256:replace-with-64-hex-digest
# cloudflare/cloudflared:2026.8.2 multi-architecture manifest, resolved 2026-08-29.
AFTERTICK_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:0aa26e284f05e6c77ae375b8c9c11d9eb6a448fb7bcd8d40f31cb6176189eb38
AFTERTICK_DEPLOY_ENV_FILE=/etc/aftertick/runtime.env
AFTERTICK_MIGRATION_ENV_FILE=/etc/aftertick/migration.env
AFTERTICK_TUNNEL_TOKEN_FILE=/etc/aftertick/cloudflared.token
AFTERTICK_CLOUDFLARED_METRICS_PORT=20241
AFTERTICK_BIND_ADDRESS=127.0.0.1
AFTERTICK_HTTP_PORT=8080
POSTGRES_DB=aftertick
POSTGRES_USER=aftertick
POSTGRES_PASSWORD=generate-a-long-random-password
REDIS_PASSWORD=generate-a-different-long-random-password
