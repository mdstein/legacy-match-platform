# Copy to a protected file outside the release bundle. The registration command
# generates AFTERTICK_NODE_TOKEN; use the same manifest secret as the API.
AFTERTICK_API_URL=https://play.aftertick.example
AFTERTICK_NODE_TOKEN=replace-with-registered-node-token
MANIFEST_SIGNING_SECRET=replace-with-the-api-manifest-signing-secret

AFTERTICK_SERVER_ROOT=C:\ProgramData\Aftertick\tools\csgo-server
AFTERTICK_SRCDS_LAUNCHER=C:\ProgramData\Aftertick\service\start-srcds-hidden.ps1
AFTERTICK_NODE_INSTANCE_KEY=csgo-01
AFTERTICK_SERVER_ADDRESS=game-na-east.aftertick.example:27115
AFTERTICK_SRCDS_HOST=0.0.0.0
AFTERTICK_SRCDS_PORT=27115
AFTERTICK_GOTV_PORT=27120
# Always-on A2S latency responder; match connections continue to use 27115.
AFTERTICK_LATENCY_PROBE_PORT=27125
AFTERTICK_SRCDS_LAN=0
# Create this token for base AppID 4465480 at
# https://steamcommunity.com/dev/managegameservers and keep it secret.
AFTERTICK_SRCDS_GSLT=replace-with-32-character-app-4465480-token
AFTERTICK_SRCDS_RCON=generate-12-to-128-safe-random-characters
AFTERTICK_SRCDS_IDLE_PASSWORD=generate-a-different-16-to-128-safe-random-password
AFTERTICK_NODE_HEARTBEAT_MS=2000
AFTERTICK_SERVER_BUILD_ID=12426148
AFTERTICK_PLUGIN_VERSION=0.1.0
