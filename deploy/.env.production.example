NODE_ENV=production
HOST=0.0.0.0
PORT=8787
AFTERTICK_PUBLIC_URL=https://back2go.net
CORS_ORIGINS=https://back2go.net
# Semicolon-separated region=host:game-port A2S targets. Configure only regions
# with live, externally reachable game-node routes.
AFTERTICK_LATENCY_PROBE_ENDPOINTS=NA East=game.back2go.net:27125
AFTERTICK_LATENCY_PROBE_CHALLENGE_SECONDS=120
AFTERTICK_LATENCY_MEASUREMENT_SECONDS=900

DATABASE_URL=postgres://aftertick:replace-me@postgres.example.internal:5432/aftertick?sslmode=require
REDIS_URL=rediss://default:replace-me@redis.example.internal:6379/0
SESSION_SECRET=generate-at-least-32-random-bytes
MANIFEST_SIGNING_SECRET=generate-a-different-32-byte-secret
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000

STEAM_API_KEY=
AFTERTICK_BOOTSTRAP_ADMIN_STEAM_ID=

S3_ENDPOINT=https://object-storage.example
S3_REGION=us-east-1
S3_BUCKET=aftertick-demos
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
AFTERTICK_DEMO_RETENTION_DAYS=90
AFTERTICK_RETENTION_BATCH_SIZE=100
AFTERTICK_BACKUP_RETENTION_DAYS=30
AFTERTICK_BACKUP_KEEP_MINIMUM=3

METRICS_BEARER_TOKEN=generate-a-third-32-byte-secret
OTEL_SERVICE_NAME=aftertick-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
