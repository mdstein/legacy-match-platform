HOST=127.0.0.1
PORT=8787
AFTERTICK_PUBLIC_URL=http://127.0.0.1:5173
DATABASE_URL=postgres://aftertick:aftertick-local-postgres@127.0.0.1:5432/aftertick
REDIS_URL=redis://:aftertick-local-redis@127.0.0.1:6379/0
SESSION_SECRET=replace-with-at-least-32-random-bytes
MANIFEST_SIGNING_SECRET=replace-with-a-different-32-byte-random-secret
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=30
RATE_LIMIT_WINDOW_MS=60000
STEAM_API_KEY=
AFTERTICK_BOOTSTRAP_ADMIN_STEAM_ID=
METRICS_BEARER_TOKEN=replace-with-a-different-32-byte-metrics-secret
OTEL_SERVICE_NAME=aftertick-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1

POSTGRES_DB=aftertick
POSTGRES_USER=aftertick
POSTGRES_PASSWORD=aftertick-local-postgres
REDIS_PASSWORD=aftertick-local-redis

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=aftertick-demos
S3_ACCESS_KEY=aftertick-local
S3_SECRET_KEY=aftertick-local-minio-secret
AFTERTICK_DEMO_RETENTION_DAYS=90
AFTERTICK_RETENTION_BATCH_SIZE=100
AFTERTICK_BACKUP_RETENTION_DAYS=30
AFTERTICK_BACKUP_KEEP_MINIMUM=3
AFTERTICK_PROMETHEUS_RETENTION=30d
AFTERTICK_TEMPO_RETENTION=24h
AFTERTICK_ALERT_RETENTION=120h
MINIO_ROOT_USER=aftertick-local
MINIO_ROOT_PASSWORD=aftertick-local-minio-secret

# Dev mode: set this to auto-authenticate without Steam login
# DEV_PLAYER_ID=some-uuid-from-players-table
